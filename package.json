{
  "name": "choice-onsite-expedition",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "sequence:validate": "tsx scripts/validate-v2-sequences.ts",
    "simulate:v2": "tsx scripts/simulate-v2-recovery.ts",
    "analyze": "node scripts/analyze-social-beta.mjs",
    "package:field": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-field.ps1"
  },
  "dependencies": {
    "@jspsych/plugin-html-button-response": "^2.1.0",
    "express": "^5.1.0",
    "jspsych": "^8.2.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
